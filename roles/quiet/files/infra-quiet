#!/bin/bash
# Quiet hours (roles/quiet, docs/host.md "Quiet hours"): the server stands in a
# room people sleep in, so from QUIET_START to QUIET_END (wall clock in QUIET_TIMEZONE)
# the GPU runs at a lower power limit and the CPU at a lower top frequency.
#
#   infra-quiet start   lower both (infra-quiet-start.timer)
#   infra-quiet end     back to the defaults: the GPU's power.default_limit and the
#                       CPU's cpuinfo_max_freq (infra-quiet-end.timer)
#   infra-quiet auto    start or end, whichever the clock says (infra-quiet-boot.service,
#                       and provisioning)
#
# The settings come from /etc/infra/quiet.env, which provisioning writes; an
# invalid one changes nothing and exits 1. The GPU part runs only where
# nvidia-smi exists, the CPU part only where cpufreq exists; whatever is already
# at its target is left alone. In quiet hours a GPU without persistence mode gets
# it, or the driver would drop the lower limit when the GPU goes idle and unloads.
# Logs one line; exits 1 if any part failed.
set -euo pipefail

readonly config="${INFRA_QUIET_CONFIG:-/etc/infra/quiet.env}"
readonly cpufreq="${INFRA_QUIET_CPUFREQ:-/sys/devices/system/cpu/cpufreq}"
readonly nvidia_smi="${INFRA_QUIET_NVIDIA_SMI:-nvidia-smi}"
readonly zoneinfo=/usr/share/zoneinfo
readonly time_pattern='^([01][0-9]|2[0-3]):[0-5][0-9]$'
readonly zone_pattern='^[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+)*$'
readonly watts_pattern='^([0-9]+)(\.([0-9]{1,2}))?$'

start="" end="" zone="" gpu_watts="" cpu_percent=""
failures=0
changes=0
notes=()

die() {
  printf 'infra-quiet: FAILED: %s; nothing was changed\n' "$*" >&2
  exit 1
}

note() {
  notes+=("$*")
}

failed() {
  notes+=("FAILED: $*")
  failures=$((failures + 1))
}

minutes() {
  echo $((10#${1%%:*} * 60 + 10#${1##*:}))
}

load_config() {
  local key value
  [ -r "$config" ] || die "$config is missing (provision with --tags quiet)"
  while IFS='=' read -r key value; do
    case "$key" in
      '' | '#'*) ;;
      QUIET_START) start="$value" ;;
      QUIET_END) end="$value" ;;
      QUIET_TIMEZONE) zone="$value" ;;
      QUIET_GPU_POWER_LIMIT_W) gpu_watts="$value" ;;
      QUIET_CPU_MAX_PERCENT) cpu_percent="$value" ;;
      *) die "unknown setting '$key' in $config" ;;
    esac
  done <"$config"
  [[ "$start" =~ $time_pattern ]] || die "QUIET_START '$start' is not HH:MM"
  [[ "$end" =~ $time_pattern ]] || die "QUIET_END '$end' is not HH:MM"
  [ "$start" != "$end" ] || die "QUIET_START and QUIET_END are both $start"
  [[ "$zone" =~ $zone_pattern ]] && [ -f "$zoneinfo/$zone" ] || die "QUIET_TIMEZONE '$zone' is not a time zone in $zoneinfo"
  [[ "$gpu_watts" =~ ^[0-9]{1,4}$ ]] && [ "$gpu_watts" -ge 50 ] && [ "$gpu_watts" -le 1000 ] ||
    die "QUIET_GPU_POWER_LIMIT_W '$gpu_watts' is not whole watts from 50 to 1000"
  [[ "$cpu_percent" =~ ^[0-9]{1,3}$ ]] && [ "$cpu_percent" -ge 30 ] && [ "$cpu_percent" -le 100 ] ||
    die "QUIET_CPU_MAX_PERCENT '$cpu_percent' is not a whole percent from 30 to 100"
}

# in_quiet_hours <HH:MM>: the window may run over midnight (23:00-08:00) or not.
in_quiet_hours() {
  local now from to
  now="$(minutes "$1")" from="$(minutes "$start")" to="$(minutes "$end")"
  if [ "$from" -lt "$to" ]; then
    [ "$now" -ge "$from" ] && [ "$now" -lt "$to" ]
  else
    [ "$now" -ge "$from" ] || [ "$now" -lt "$to" ]
  fi
}

# nvidia-smi reports watts with two decimals; compare them as centiwatts.
centiwatts() {
  [[ "$1" =~ $watts_pattern ]] || return 1
  local fraction="${BASH_REMATCH[3]:-0}"
  [ "${#fraction}" -eq 2 ] || fraction="${fraction}0"
  echo $((10#${BASH_REMATCH[1]} * 100 + 10#$fraction))
}

watts() {
  printf '%d.%02d' $(($1 / 100)) $(($1 % 100))
}

# gpu <quiet: 1 or 0>
gpu() {
  local quiet="$1" out index limit default min max persistence target what
  if ! command -v "$nvidia_smi" >/dev/null 2>&1; then
    note "GPU: no nvidia-smi, skipped"
    return 0
  fi
  if ! out="$("$nvidia_smi" --query-gpu=index,power.limit,power.default_limit,power.min_limit,power.max_limit,persistence_mode \
    --format=csv,noheader,nounits 2>&1)"; then
    failed "GPU: nvidia-smi: ${out//$'\n'/ }"
    return 0
  fi
  while IFS=', ' read -r index limit default min max persistence; do
    [ -n "$index" ] || continue
    if ! limit="$(centiwatts "$limit")" || ! default="$(centiwatts "$default")" || ! min="$(centiwatts "$min")" || ! max="$(centiwatts "$max")"; then
      note "GPU$index: no power limit to set, skipped"
      continue
    fi
    if [ "$quiet" = 1 ]; then
      target=$((gpu_watts * 100)) what="$(watts "$target") W"
      if [ "$target" -lt "$min" ]; then
        target="$min" what="$(watts "$min") W (its minimum, above the $gpu_watts W asked for)"
      elif [ "$target" -gt "$max" ]; then
        target="$max" what="$(watts "$max") W (its maximum, below the $gpu_watts W asked for)"
      fi
      if [ "$persistence" = Disabled ]; then
        if "$nvidia_smi" -i "$index" -pm 1 >/dev/null 2>&1; then
          changes=$((changes + 1))
          note "GPU$index persistence mode turned on"
        else
          failed "GPU$index: nvidia-smi -pm 1 refused persistence mode"
        fi
      fi
    else
      target="$default" what="$(watts "$default") W (its default)"
    fi
    if [ "$limit" -eq "$target" ]; then
      note "GPU$index already $what"
    elif "$nvidia_smi" -i "$index" -pl "$(watts "$target")" >/dev/null 2>&1; then
      changes=$((changes + 1))
      note "GPU$index $what, was $(watts "$limit") W"
    else
      failed "GPU$index: nvidia-smi -pl $(watts "$target") refused"
    fi
  done <<<"$out"
}

# cpu <quiet: 1 or 0>
cpu() {
  local quiet="$1" policy max min current target count=0 changed=0
  local -a policies
  shopt -s nullglob
  policies=("$cpufreq"/policy*)
  shopt -u nullglob
  if [ "${#policies[@]}" -eq 0 ]; then
    note "CPU: no cpufreq, skipped"
    return 0
  fi
  for policy in "${policies[@]}"; do
    if ! read -r max <"$policy/cpuinfo_max_freq" || ! read -r min <"$policy/cpuinfo_min_freq" || ! read -r current <"$policy/scaling_max_freq" ||
      [[ ! "$max" =~ ^[0-9]+$ ]] || [[ ! "$min" =~ ^[0-9]+$ ]] || [[ ! "$current" =~ ^[0-9]+$ ]]; then
      failed "CPU: cannot read the frequencies in $policy"
      continue
    fi
    count=$((count + 1))
    target="$max"
    [ "$quiet" = 0 ] || target=$((max * cpu_percent / 100))
    [ "$target" -ge "$min" ] || target="$min"
    [ "$current" -ne "$target" ] || continue
    if printf '%s\n' "$target" 2>/dev/null >"$policy/scaling_max_freq"; then
      changed=$((changed + 1))
    else
      failed "CPU: $policy refused scaling_max_freq $target"
    fi
  done
  changes=$((changes + changed))
  if [ "$quiet" = 1 ]; then
    note "CPU top frequency ${cpu_percent}% of its maximum on $count policies ($changed changed)"
  else
    note "CPU top frequency back to its maximum on $count policies ($changed changed)"
  fi
}

case "${1:-}" in
  start | end | auto) ;;
  *)
    echo "usage: infra-quiet start|end|auto" >&2
    exit 2
    ;;
esac
load_config
mode="$1"
if [ "$mode" = auto ]; then
  now="${INFRA_QUIET_NOW:-$(TZ="$zone" date +%H:%M)}"
  [[ "$now" =~ $time_pattern ]] || die "the time '$now' is not HH:MM"
  if in_quiet_hours "$now"; then mode=start; else mode=end; fi
  mode_note="auto at $now $zone: "
fi
quiet=0
[ "$mode" = end ] || quiet=1
gpu "$quiet"
cpu "$quiet"
[ "$changes" -gt 0 ] || note "no change"
summary="${notes[0]}"
for line in "${notes[@]:1}"; do
  summary+="; $line"
done
if [ "$quiet" = 1 ]; then state="quiet hours ($start-$end $zone)"; else state="normal hours"; fi
if [ "$failures" -gt 0 ]; then
  printf 'infra-quiet: FAILED: %s%s: %s\n' "${mode_note:-}" "$state" "$summary" >&2
  exit 1
fi
printf 'infra-quiet: %s%s: %s\n' "${mode_note:-}" "$state" "$summary"

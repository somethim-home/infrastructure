# Managed by Ansible (roles/host/tasks/pg_backup.yml). See docs/database.md, "Backups".
[Unit]
Description=Daily dump of the portfolio database to R2

[Timer]
# Before the 04:00 UTC unattended-upgrades reboot window.
OnCalendar=*-*-* 02:30:00 UTC
RandomizedDelaySec=15m
# A day missed while the server was off runs at the next boot.
Persistent=true

[Install]
WantedBy=timers.target

{# Rendered by release.yml into the bundle as home/.env (0600). Compose reads it
   only for interpolation in docker-compose.yml: the image to run and the
   account it runs as (its image's own, 65532, which owns home-data, home-keys
   and /srv/media/home-files; roles/host), and the media account's group,
   which home-server joins to write into the film and series library. No
   secrets here. A rollback (build-bundle.sh --pin) rewrites HOME_IMAGE to a
   digest; :latest lets Watchtower follow the tag. #}
HOME_IMAGE={{ home_image_repo }}:latest
HOME_UID={{ home_uid }}
HOME_GID={{ home_gid }}
MEDIA_GID={{ media_gid }}

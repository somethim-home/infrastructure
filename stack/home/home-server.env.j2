{# Rendered by release.yml into the bundle as home/home-server.env (0600). Only
   home-server reads it: its settings, and where home-keys wrote its keys and
   passwords (no secret is in this file). See docs/stacks.md. #}
HOME_SERVER_ADDR=0.0.0.0:8080
HOME_OWNER_EMAIL={{ home_owner_email }}
HOME_PUBLIC_ORIGIN=https://{{ home_domain }}
HOME_DATABASE_PATH=/data/home.db
HOME_SECRET_KEY_FILE=/run/keys/secret_key
HOME_DATA_KEY_FILE=/run/keys/data_key
HOME_TRUST_FORWARDED_FOR=1
HOME_MAILER=smtp
HOME_SMTP_HOST=smtp.resend.com
HOME_SMTP_TLS=tls
HOME_SMTP_PORT=465
HOME_SMTP_USER=resend
HOME_SMTP_PASSWORD_FILE=/run/keys/smtp_password
HOME_MAIL_FROM=Home <home@arbikullakshi.com>
{% if home_beszel_user %}
HOME_BESZEL_URL=http://beszel:8090
HOME_BESZEL_USER={{ home_beszel_user }}
HOME_BESZEL_PASSWORD_FILE=/run/keys/beszel_password
{% else %}
HOME_BESZEL_URL=
{% endif %}
{% if home_power_key | default('') %}
HOME_POWER_DIR=/run/power
HOME_POWER_KEY_FILE=/run/keys/power_key
{% else %}
HOME_POWER_DIR=
{% endif %}
HOME_FILES_ROOT=/files
HOME_FILES_CAPACITY={{ home_files_capacity }}

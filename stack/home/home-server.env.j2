{# Rendered by release.yml into the bundle as home/home-server.env (0600). Only
   home-server reads it: its settings, and where home-keys wrote its keys and
   passwords (no secret is in this file). See docs/stacks.md. The web app is
   in Home's image at /app (HOME_WEB_APP_DIR, set there), so nothing here. #}
HOME_SERVER_ADDR=0.0.0.0:8080
HOME_OWNER_EMAIL={{ home_owner_email }}
HOME_PUBLIC_ORIGIN=https://{{ home_domain }}
HOME_DATABASE_PATH=/data/home.db
HOME_SECRET_KEY_FILE=/run/keys/secret_key
HOME_DATA_KEY_FILE=/run/keys/data_key
HOME_TRUST_FORWARDED_FOR=1
HOME_MAILER=smtp
HOME_SMTP_HOST=smtp.resend.com
HOME_SMTP_TLS=tls
HOME_SMTP_PORT=465
HOME_SMTP_USER=resend
HOME_SMTP_PASSWORD_FILE=/run/keys/smtp_password
HOME_MAIL_FROM=Home <home@arbikullakshi.com>
{% if home_beszel_user %}
HOME_BESZEL_URL=http://beszel:8090
HOME_BESZEL_USER={{ home_beszel_user }}
HOME_BESZEL_PASSWORD_FILE=/run/keys/beszel_password
{% else %}
HOME_BESZEL_URL=
{% endif %}
{% if home_power_key | default('') %}
HOME_POWER_DIR=/run/power
HOME_POWER_KEY_FILE=/run/keys/power_key
{% else %}
HOME_POWER_DIR=
{% endif %}
HOME_FILES_ROOT=/files
HOME_FILES_CAPACITY={{ home_files_capacity }}
{# Media: the library on the media disk (bind-mounted), its catalogue and cache
   on the SSD in home-data (the cache is not backed up). Transcodes are capped
   by Home itself, halved in quiet hours; the host caps the GPU's power then
   (roles/quiet). TMDB only with its token, read from the key file. #}
HOME_MEDIA_FILMS=/data/media/films
HOME_MEDIA_SERIES=/data/media/series
HOME_MEDIA_DATABASE_PATH=/data/media.db
HOME_MEDIA_CACHE=/data/media-cache
HOME_MEDIA_HWACCEL=auto
HOME_MEDIA_TRANSCODES={{ home_media_transcodes }}
HOME_MEDIA_TRANSCODES_QUIET={{ home_media_transcodes_quiet }}
{% if quiet_hours_enabled %}
HOME_MEDIA_QUIET_HOURS={{ quiet_hours_start }}-{{ quiet_hours_end }}
HOME_MEDIA_TIMEZONE={{ quiet_hours_timezone }}
{% else %}
HOME_MEDIA_QUIET_HOURS=
{% endif %}
{% if home_tmdb_read_token | default('') %}
HOME_TMDB_READ_TOKEN_FILE=/run/keys/tmdb_read_token
{% else %}
HOME_TMDB_READ_TOKEN_FILE=
{% endif %}
{# Books: the library (books.db, the EPUBs, covers) in home-data, backed up;
   the catalog and books come from www.gutenberg.org over https. #}
HOME_BOOKS_LIBRARY=/data/books
{# AI: llama-server (stack/ai) on the internal home-llm network; the models are
   production.yml's home_ai_models, the first the default. Two answers at once
   with an 8k context each by day (llama-server's two slots of its 16k
   context), one with 4k in quiet hours, when the day-only models rest. #}
HOME_AI_URL=http://llama:8080
{% set ai_models = [] %}{% for model in home_ai_models %}{% set _ = ai_models.append(model.id ~ '=' ~ model.label ~ '|' ~ model.about) %}{% endfor %}
HOME_AI_MODELS={{ ai_models | join(';') }}
HOME_AI_DAY_ONLY_MODELS={{ home_ai_models | selectattr('day_only') | map(attribute='id') | join(',') }}
HOME_AI_DATABASE_PATH=/data/ai.db
HOME_AI_CONCURRENT=2
HOME_AI_QUIET_CONCURRENT=1
HOME_AI_CONTEXT_TOKENS=8192
HOME_AI_QUIET_CONTEXT_TOKENS=4096
{% if quiet_hours_enabled %}
HOME_AI_QUIET_HOURS={{ quiet_hours_start }}-{{ quiet_hours_end }}
HOME_AI_TIMEZONE={{ quiet_hours_timezone }}
{% else %}
HOME_AI_QUIET_HOURS=off
{% endif %}

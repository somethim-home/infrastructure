{# Rendered by release.yml into the bundle as home/home-keys.env (0600). Read
   only by home-keys, which writes each value into its own file in the
   home-keys volume for home-server: the key that HMACs client addresses
   (HOME_SECRET_KEY), the key that encrypts sign-in factors and the AI chats
   (HOME_DATA_KEY), the Resend API key home-server signs in to Resend's SMTP
   with (HOME_RESEND_API_KEY), and the read-only Beszel user's password
   (HOME_BESZEL_PASSWORD, empty until production.yml names that user), the
   key Home signs its power requests to the host with (HOME_POWER_KEY, the
   host's /etc/infra/home-power.key; empty: no power control), and TMDB's API
   Read Access Token for Media's online details (HOME_TMDB_READ_TOKEN; empty:
   Wikidata only, no pictures). See docs/stacks.md. #}
HOME_SECRET_KEY={{ home_secret_key }}
HOME_DATA_KEY={{ home_data_key }}
HOME_SMTP_PASSWORD={{ home_resend_api_key }}
HOME_BESZEL_PASSWORD={{ home_beszel_password | default('') if home_beszel_user else '' }}
HOME_POWER_KEY={{ home_power_key | default('') }}
HOME_TMDB_READ_TOKEN={{ home_tmdb_read_token | default('') }}

{# Rendered by release.yml into the bundle as media/.env (0600). Compose reads
   it only for interpolation in docker-compose.yml: the account every container
   runs as (roles/host creates it with this uid and gid and owns the library
   with it), Home's https name and the certificate's ACME contact (home-tls),
   the server's tailnet name (the links page and Beszel's address,
   http://<server>:<port>), and the status dashboard's login name (beszel). No secrets here. TAILSCALE_IP is not here: infra-apply exports it
   from /etc/infra/host.env. #}
MEDIA_UID={{ media_uid }}
MEDIA_GID={{ media_gid }}
HOME_DOMAIN={{ home_domain }}
SERVER_NAME={{ server_name }}
ACME_EMAIL={{ acme_email }}
STATUS_OWNER_EMAIL={{ status_owner_email }}

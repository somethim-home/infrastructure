{# Rendered by release.yml into the bundle as ai/.env (0600). Compose reads it
   only for interpolation in docker-compose.yml: the account the containers run
   as (roles/host creates it with this uid and gid), the models ollama-pull
   fetches, space-separated, and the GGUF files llama-server serves, as
   <id>:<file> pairs (production.yml's home_ai_models; the owner downloads the
   files into llama-models, RUNBOOK.md "Home's AI models"). No secrets here.
   TAILSCALE_IP is not here: infra-apply exports it from /etc/infra/host.env. #}
AI_UID={{ ai_uid }}
AI_GID={{ ai_gid }}
OLLAMA_MODELS={{ ollama_models | join(' ') }}
{% set llama_models = [] %}{% for model in home_ai_models %}{% set _ = llama_models.append(model.id ~ ':' ~ model.file) %}{% endfor %}
LLAMA_MODELS={{ llama_models | join(' ') }}

{# Rendered by release.yml into the bundle as portfolio/.env (0600). Compose
   reads it only for interpolation in docker-compose.yml: the image to run and
   the public host names (PREVIEW_DOMAIN is production.yml's preview_domain, or
   the apex again when that is empty). No secrets here. A rollback
   (build-bundle.sh --pin) rewrites PORTFOLIO_IMAGE to a digest; :latest lets
   Watchtower follow the tag. #}
PORTFOLIO_IMAGE={{ portfolio_image_repo }}:latest
APEX_DOMAIN={{ apex_domain }}
WWW_DOMAIN={{ www_domain }}
PREVIEW_DOMAIN={{ preview_domain | default('', true) or apex_domain }}

{# Rendered by release.yml into the hetzner bundle as database/backup.env (0600).
   No stack reads it: infra-pg-backup (roles/host) passes it to the one-off
   rclone container that streams the daily pg_dump into the private R2 bucket
   portfolio-backups. A key of its own (R2_BACKUP_*), allowed to write that
   bucket alone, so the portfolio's own R2 key cannot reach its backups. See
   docs/database.md, "Backups". #}
RCLONE_S3_PROVIDER=Cloudflare
RCLONE_S3_ENDPOINT=https://{{ r2_account_id }}.r2.cloudflarestorage.com
RCLONE_S3_ACCESS_KEY_ID={{ r2_backup_access_key_id }}
RCLONE_S3_SECRET_ACCESS_KEY={{ r2_backup_secret_access_key }}
